{
  "name": "jungle-wagering-processor",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "mikro-orm": "bun ./node_modules/.bin/mikro-orm",
    "migration:up": "bun run mikro-orm migration:up",
    "migration:down": "bun run mikro-orm migration:down",
    "migration:create": "bun run mikro-orm migration:create",
    "db:create-test": "bun run scripts/create-test-db.ts",
    "db:reset-test": "./scripts/reset-databases.sh test",
    "db:reset-all": "./scripts/reset-databases.sh all",
    "db:migrate-all": "./scripts/reset-databases.sh migrate",
    "db:verify": "bun run scripts/verify-db-invariants.ts",
    "db:reset-outbox": "bun run scripts/reset-outbox.ts",
    "test": "bun run db:create-test && bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "NODE_ENV=test bun test test/unit",
    "test:integration": "NODE_ENV=test bun test --max-concurrency=1 test/integration",
    "test:e2e": "NODE_ENV=test bun test --max-concurrency=1 test/e2e",
    "test:all": "NODE_ENV=test bun test --max-concurrency=1",
    "test:watch": "NODE_ENV=test bun test --watch test/unit",
    "test:coverage": "NODE_ENV=test bun test --coverage test/",
    "test:e2e:shell": "./scripts/test-out-of-order.sh && ./scripts/test-queue.sh",
    "test:sqs": "docker compose up -d --wait localstack postgres && bun test test/integration/aws/sqs-real.integration.spec.ts",
    "test:load": "NODE_ENV=test bun run test/load/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^7.0.2",
    "@mikro-orm/migrations": "^7.0.2",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.0.2",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "^12.0.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^18.0.8",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.0.2",
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.1.3",
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "~5.9.3"
  }
}
