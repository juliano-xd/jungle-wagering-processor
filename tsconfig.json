{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
  },
  "types": ["node"],
  "include": [
    "src",
    "scripts",
    "test",
    "mikro-orm.config.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.mjs", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}
