# ---- Banco de dados ----
# Local dev (Postgres do sistema):
DB_HOST=127.0.0.1
DB_PORT=5432
# Docker compose (container Postgres na porta 5433):
# DB_PORT=5433

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wagering_db
DB_NAME_TEST=wagering_db_test

# ---- Filas (seção 10) ----
# `memory` → InMemoryQueueAdapter (dev/testes)
# `aws`    → AWS SQS (LocalStack local ou AWS real)
QUEUE_BACKEND=memory

# Habilita POST /_dev/queue/publish (SÓ DEV — nunca em prod)
DEV_QUEUE_ENDPOINT=true

WAGER_CONSUMER_ENABLED=true
WAGER_CONSUMER_POLL_MS=1000
WAGER_CONSUMER_BATCH_SIZE=10
WAGER_CONSUMER_WAIT_SECONDS=5
WAGER_CONSUMER_NACK_BACKOFF_S=10

# ---- SQS real (só se QUEUE_BACKEND=aws) ----
# Com docker compose + LocalStack:
# SQS_REGION=us-east-1
# SQS_ENDPOINT=http://localhost:4566
# SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
# SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
# SQS_MAX_RECEIVE_COUNT=5
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ---- Outbox publisher ----
# `console` → loga JSON no stdout (dev)
# `queue`   → publica via QUEUE_PUBLISHER (respeita QUEUE_BACKEND)
OUTBOX_PUBLISHER_BACKEND=console
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20

# ---- Pending reference worker ----
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=5000
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_MAX_ATTEMPTS=12
PENDING_REFERENCE_BASE_BACKOFF_MS=5000
PENDING_REFERENCE_MAX_BACKOFF_MS=60000
