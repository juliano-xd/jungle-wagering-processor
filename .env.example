# ---- Banco de dados ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wagering_db
DB_NAME_TEST=wagering_db_test   # usado quando NODE_ENV=test

# ---- Filas (seção 10) ----
QUEUE_BACKEND=memory            # memory | aws
DEV_QUEUE_ENDPOINT=true         # habilita POST /_dev/queue/publish (só dev)
WAGER_CONSUMER_ENABLED=true
WAGER_CONSUMER_POLL_MS=1000
WAGER_CONSUMER_BATCH_SIZE=10
WAGER_CONSUMER_WAIT_SECONDS=5
WAGER_CONSUMER_NACK_BACKOFF_S=10

# ---- SQS real (só se QUEUE_BACKEND=aws) ----
# SQS_REGION=us-east-1
# SQS_ENDPOINT=http://localhost:4566
# SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
# SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
# SQS_MAX_RECEIVE_COUNT=5
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ---- Workers ----
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=5000
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_MAX_ATTEMPTS=12
PENDING_REFERENCE_BASE_BACKOFF_MS=5000
PENDING_REFERENCE_MAX_BACKOFF_MS=60000
