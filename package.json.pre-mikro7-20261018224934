{
  "name": "jungle-wagering-processor",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "db:verify": "bun run scripts/verify-db-invariants.ts",
    "db:reset-outbox": "bun run scripts/reset-outbox.ts",
    "migration:up": "bun run mikro-orm migration:up",
    "migration:down": "bun run mikro-orm migration:down",
    "migration:create": "bun run mikro-orm migration:create",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --max-concurrency=1 test/integration",
    "test:e2e": "bun test --max-concurrency=1 test/e2e",
    "test:all": "bun test --max-concurrency=1",
    "test:watch": "bun test --watch test/unit",
    "test:coverage": "bun test --coverage test/",
    "test:e2e:shell": "./scripts/test-out-of-order.sh && ./scripts/test-queue.sh"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^7.0.2",
    "@mikro-orm/migrations": "^7.0.2",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.0.2",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "decimal.js": "^10.4.3",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.1.3",
    "@swc-node/register": "^1.10.9",
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "~5.9.3"
  }
}
