import { describe, it, expect, beforeEach } from 'bun:test';
import { MikroORM, EntityManager } from '@mikro-orm/postgresql';
import config from '../../../mikro-orm.config';
import { WalletService } from '../../application/services/wallet.service';
import { Wallet } from '../../domain/entities/wallet';
import { WalletLedgerEntry } from '../../domain/entities/wallet-ledger-entry';
import { InMemoryMessagePublisher } from './adapters/in-memory-message-publisher';

describe('Async Messaging & WalletService Integration (InMemory SQS Mock)', () => {
  let orm: MikroORM;
  let em: EntityManager;
  let walletService: WalletService;
  let publisher: InMemoryMessagePublisher;

  beforeEach(async () => {
    if (!orm) {
      orm = await MikroORM.init(config);
    }
    em = orm.em.fork();
    walletService = new WalletService(em);
    publisher = new InMemoryMessagePublisher(walletService);

    await em.nativeDelete(WalletLedgerEntry, {});
    await em.nativeDelete(Wallet, {});
    em.clear();
  });

  it('deve simular o fluxo assíncrono de aposta via mensageria e atualizar o saldo da carteira', async () => {
    // 1. Abre a carteira com $500.00
    const wallet = await walletService.createWallet('500.00', 'USD');

    // 2. Publica o evento de débito (aposta) na fila simulada
    const referenceId = 'bet-async-ticket-001';
    await publisher.publish('wagering-events-queue', {
      action: 'DEBIT',
      walletId: wallet.id,
      amount: '150.00',
      currency: 'USD',
      referenceId,
    });

    // 3. Valida se o saldo foi processado atomicamente e o ledger foi gravado
    em.clear();
    const updatedWallet = await em.findOne(Wallet, { id: wallet.id });
    expect(updatedWallet?.balanceInCents).toBe(35000); // 500.00 - 150.00 = 350.00

    const entry = await em.findOne(WalletLedgerEntry, { referenceId });
    expect(entry).toBeDefined();
    expect(entry?.amountInCents).toBe(15000);
  });
});
