import { describe, it, expect, beforeAll, afterAll, beforeEach } from 'bun:test';
import { MikroORM, EntityManager } from '@mikro-orm/postgresql';
import config from '../../../mikro-orm.config';
import { WalletService } from './wallet.service';
import { Wallet } from '../../domain/entities/wallet';
import { WalletLedgerEntry, LedgerDirection } from '../../domain/entities/wallet-ledger-entry';

describe('WalletService Integration', () => {
  let orm: MikroORM;
  let em: EntityManager;
  let walletService: WalletService;

  beforeAll(async () => {
    orm = await MikroORM.init(config);
    em = orm.em.fork();
    walletService = new WalletService(em);
  });

  afterAll(async () => {
    await orm.close();
  });

  beforeEach(async () => {
    await em.nativeDelete(WalletLedgerEntry, {});
    await em.nativeDelete(Wallet, {});
    em.clear();
  });

  it('deve criar uma nova carteira no banco de dados', async () => {
    const wallet = await walletService.createWallet('50.00', 'USD');
    expect(wallet.id).toBeDefined();
    expect(wallet.balanceInCents).toBe(5000);
    
    const saved = await em.findOne(Wallet, { id: wallet.id });
    expect(saved?.balanceInCents).toBe(5000);
  });

  it('deve adicionar saldo a uma carteira existente e registrar no ledger', async () => {
    const wallet = await walletService.createWallet('100.00', 'USD');
    
    await walletService.credit(wallet.id, '25.00', 'USD', 'ref-credit-1');
    
    em.clear(); // Limpa o cache para forçar a busca do banco de dados real
    const updatedWallet = await em.findOne(Wallet, { id: wallet.id });
    expect(updatedWallet?.balanceInCents).toBe(12500);

    const entry = await em.findOne(WalletLedgerEntry, { referenceId: 'ref-credit-1' });
    expect(entry).toBeDefined();
    expect(entry?.type).toBe(LedgerDirection.CREDIT);
    expect(entry?.amountInCents).toBe(2500);
  });

  it('deve debitar saldo de uma carteira existente e registrar no ledger', async () => {
    const wallet = await walletService.createWallet('100.00', 'USD');
    
    await walletService.debit(wallet.id, '30.00', 'USD', 'ref-debit-1');
    
    em.clear();
    const updatedWallet = await em.findOne(Wallet, { id: wallet.id });
    expect(updatedWallet?.balanceInCents).toBe(7000);

    const entry = await em.findOne(WalletLedgerEntry, { referenceId: 'ref-debit-1' });
    expect(entry).toBeDefined();
    expect(entry?.type).toBe(LedgerDirection.DEBIT);
  });

  it('deve abortar a transação e falhar se o saldo for insuficiente', async () => {
    const wallet = await walletService.createWallet('10.00', 'USD');
    
    // Tenta debitar $50.00
    await expect(
      walletService.debit(wallet.id, '50.00', 'USD', 'ref-debit-fail')
    ).rejects.toThrow('Insufficient funds');
    
    em.clear();
    const unchangedWallet = await em.findOne(Wallet, { id: wallet.id });
    expect(unchangedWallet?.balanceInCents).toBe(1000); // Saldo continua 10.00
    
    // O rollback da transação do MikroORM deve impedir que qualquer entrada seja salva
    const entry = await em.findOne(WalletLedgerEntry, { referenceId: 'ref-debit-fail' });
    expect(entry).toBeNull(); 
  });
});
